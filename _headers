# HTTP security headers for Netlify / Cloudflare Pages. Other hosts: set the same headers.
# frame-ancestors cannot be set from a <meta> tag, so it lives here (the app also refuses to run framed).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; media-src 'none'; connect-src https://0.peerjs.com wss://0.peerjs.com; worker-src blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
