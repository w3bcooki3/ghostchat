# HTTP security headers for Netlify / Cloudflare Pages. Other hosts: set the same headers.
# GitHub Pages can't set headers; the <meta> CSP in each page still applies there.
#
# Keep the CSP here identical to the <meta> CSP in index.html (plus frame-ancestors, which a
# <meta> tag cannot set): browsers enforce BOTH, so a stricter header silently breaks features
# such as the WebSocket relay. `npm test` checks that the two match.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# The app's CSP applies to the app only: dist/ghostchat.html and the info pages carry their own
# hash-based <meta> CSPs, and a second, stricter header policy would block their inline code.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; media-src 'none'; connect-src https://0.peerjs.com wss://0.peerjs.com wss://ghostchat-relay.mrsaini281-678.workers.dev; worker-src blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' blob:; media-src 'none'; connect-src https://0.peerjs.com wss://0.peerjs.com wss://ghostchat-relay.mrsaini281-678.workers.dev; worker-src blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Pages are never cached, so a closed conversation can't come back from the back/forward cache
# or a disk cache, and a fixed release reaches everyone on the next load.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/guide.html
  Cache-Control: no-store
/security.html
  Cache-Control: no-store
/legal.html
  Cache-Control: no-store
